# Copia este archivo a .env y completa los valores. NUNCA subas .env a un repositorio.
PORT=3000
PUBLIC_URL=https://tu-dominio.com        # URL pública de la tienda (sin / al final)
DB_PATH=./data/store.db                  # en el hosting, apunta a un disco persistente
RESERVATION_MINUTES=30                   # tiempo que se reservan las unidades mientras el cliente paga

# --- Wompi (https://comercios.wompi.co → Desarrolladores) ---
# Déjalas vacías para correr en MODO SIMULADO (no cobra; sirve para probar).
WOMPI_ENV=sandbox                        # sandbox (pruebas) o production
WOMPI_PUBLIC_KEY=                        # pub_test_...  /  pub_prod_...
WOMPI_INTEGRITY_SECRET=                  # test_integrity_... / prod_integrity_...
WOMPI_EVENTS_SECRET=                     # test_events_...    / prod_events_...

# Token para el panel /api/admin (inventario y pedidos). Usa algo largo y aleatorio.
ADMIN_TOKEN=
